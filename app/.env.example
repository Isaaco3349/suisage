# LLM (Groq, free tier works)
GROQ_API_KEY=gsk_...
# optional: force a model. Run npm run groq:models to list what your key can use. Unset means automatic.
# GROQ_MODEL=openai/gpt-oss-120b

# Sui agent keypair (testnet, for DeepBook paper signals): sui keytool generate ed25519
SUI_PRIVATE_KEY=suiprivkey...
NEXT_PUBLIC_SUI_NETWORK=testnet

# Tatum (https://dashboard.tatum.io). Sui reads use Tatum's gRPC gateway because Sui retired JSON-RPC.
# Run npm run tatum:check to see which gateway answers for your key.
TATUM_API_KEY=
# TATUM_NETWORK=testnet          defaults to NEXT_PUBLIC_SUI_NETWORK
# TATUM_GRPC_URL=sui-testnet-grpc.gateway.tatum.io:443

# Walrus Memory on MAINNET (https://memory.walrus.xyz -> create account + delegate key)
MEMWAL_PRIVATE_KEY=        # delegate private key (hex)
MEMWAL_ACCOUNT_ID=0x...    # MemWalAccount object id
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=suisage-recall

# Learning loop
GRADE_AFTER_MIN=15         # minutes before a signal is graded automatically
DEMO_MODE=false            # true enables the clearly-labelled "simulate price move" buttons
